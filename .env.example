# ---------------------------------------------------------------------------
# Urban Furniture Accounting System - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma (app + migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_furniture?schema=public"

# Separate database used by integration tests. Tests truncate data, so this
# MUST NOT point at a database you care about.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_furniture_test?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET=""
# Canonical origin of the app. Required in production behind a proxy.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Application -----------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Urban Furniture Accounting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Company / accounting defaults ----------------------------------------
# Used by the seed script to create the company profile and chart of accounts.
COMPANY_NAME="Urban Furniture"
COMPANY_CURRENCY="INR"
COMPANY_CURRENCY_SYMBOL="Rs."
# Month (1-12) the fiscal year starts in. 4 = April (India).
FISCAL_YEAR_START_MONTH="4"

# --- Seed accounts (development only) --------------------------------------
SEED_ADMIN_EMAIL="admin@urbanfurniture.test"
SEED_ADMIN_LOGIN_ID="ufowner"
SEED_ADMIN_PASSWORD="ChangeMe!123"
SEED_ACCOUNTANT_EMAIL="accountant@urbanfurniture.test"
SEED_ACCOUNTANT_LOGIN_ID="ufaccounts"
SEED_ACCOUNTANT_PASSWORD="ChangeMe!123"

# --- E2E -------------------------------------------------------------------
# Point Playwright at an already-running server instead of booting `npm run dev`.
# E2E_BASE_URL="http://127.0.0.1:3000"
